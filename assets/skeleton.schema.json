{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit fitted skeleton",
  "type": "object",
  "required": [
    "name",
    "bones"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "const": false
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "head",
          "tail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "head": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "tail": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "parent": {
            "type": "string"
          },
          "roll": {
            "type": "number"
          },
          "deform": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "rigid_objects": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
